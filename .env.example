SUPABASE_URL=
SUPABASE_SECRET_KEY=
RESEND_API_KEY=
AFINCALIA_EMAIL_FROM=
LEAD_RATE_SECRET=
CRON_SECRET=
# Datos aportados por el titular; su configuración no acredita verificación documental.
# Publicar solo tras revisar textos y ubicaciones. No usar denominaciones societarias supuestas.
AFINCALIA_LEGAL_NAME=
AFINCALIA_TAX_ID=
AFINCALIA_LEGAL_ADDRESS=
# Mantener vacío hasta aprobar una política concreta. Nunca usar un valor provisional
# para superar ready(). Un cambio de titular no modifica contratos ni registros históricos.
AFINCALIA_LEAD_RETENTION=
# Enable only after verifying persistence, permissions, email receipt and legal data.
LEADS_ENABLED=false
CONVERSION_ANALYTICS_ENABLED=false
# Only used on Vercel Preview, branch codex/validacion-formulario.
# Set to exactly one HTTPS origin, with no trailing slash; never a wildcard.
LEAD_PREVIEW_ORIGIN=
# One explicitly authorized test inbox; required only on the controlled Preview branch.
# Ignored in production. Do not put the recipient in browser-facing configuration.
LEAD_PREVIEW_RECIPIENT=

# QA only: absolute UTC deadline, at most two hours ahead; closed after expiry.
LEAD_PREVIEW_EXPIRES_AT=
